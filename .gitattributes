# 统一换行，避免 Windows / macOS / Linux 之间产生无意义 diff
* text=auto

*.kt       text eol=lf
*.java     text eol=lf
*.md       text eol=lf
*.gradle   text eol=lf
*.xml      text eol=lf
*.properties text eol=lf
*.pro      text eol=lf
*.txt      text eol=lf
*.bat      text eol=crlf

*.jar      binary
*.task     binary
*.png      binary
*.jpg      binary
*.webp     binary